<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.9.xsd">

    <changeSet id="3" author="edutech">
        <!-- Create club table -->
        <createTable tableName="club">
            <column name="id" type="INTEGER" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="color" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="club_name" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="description" type="VARCHAR(255)">
                <constraints nullable="true"/>
            </column>
            <column name="label" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <!-- Create student table -->
        <createTable tableName="student">
            <column name="id" type="INTEGER" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="uuid" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="school_id" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
                        <column name="image_url" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="first_name" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="middle_name" type="VARCHAR(255)">
                <constraints nullable="true"/>
            </column>
            <column name="last_name" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="dob" type="DATE">
                <constraints nullable="false"/>
            </column>
            <column name="wing" type="INTEGER">
                <constraints nullable="true" foreignKeyName="fk_student_club" references="club(id)"/>
            </column>
            <column name="address_id" type="INTEGER">
                <constraints nullable="true" foreignKeyName="fk_student_address" references="address(id)"/>
            </column>
            <column name="contact_id" type="INTEGER">
                <constraints nullable="true" foreignKeyName="fk_student_contact" references="contact(id)"/>
            </column>
        </createTable>

        <!-- Create bording_student table -->
        <createTable tableName="bording_student">
            <column name="id" type="INTEGER" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="student_id" type="INTEGER">
                <constraints nullable="false" foreignKeyName="fk_bording_student_student" references="student(id)"/>
            </column>
            <column name="bed_id" type="INTEGER">
                <constraints nullable="false" foreignKeyName="fk_bording_student_bed" references="bed(id)"/>
            </column>
        </createTable>
    </changeSet>

</databaseChangeLog>