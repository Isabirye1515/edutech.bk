<?xml version="1.0" encoding="UTF-8"?>

<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="
        http://www.liquibase.org/xml/ns/dbchangelog 
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.8.xsd">

    <changeSet id="001-create-bording-student" author="edutech">
        <createTable tableName="bording_student">
            <column name="id" type="INT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="student_id" type="INT">
                <constraints nullable="false"/>
            </column>
            <column name="bed_id" type="INT">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <addForeignKeyConstraint 
            baseTableName="bording_student"
            baseColumnNames="student_id"
            referencedTableName="student"
            referencedColumnNames="id"
            constraintName="fk_bording_student_student"
            onDelete="CASCADE"/>

        <addForeignKeyConstraint 
            baseTableName="bording_student"
            baseColumnNames="bed_id"
            referencedTableName="bed"
            referencedColumnNames="id"
            constraintName="fk_bording_student_bed"
            onDelete="CASCADE"/>
    </changeSet>

</databaseChangeLog>
