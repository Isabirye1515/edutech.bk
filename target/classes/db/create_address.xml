<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
  xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="
     http://www.liquibase.org/xml/ns/dbchangelog
     http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.8.xsd">

  <!-- 1. Create address table -->
<changeSet id="20250715-01-create-address" author="elijah">
    <preConditions onFail="MARK_RAN">
        <not>
            <tableExists tableName="address"/>
        </not>
    </preConditions>

    <createTable tableName="address">
        <column name="id" type="INTEGER GENERATED BY DEFAULT AS IDENTITY">
            <constraints primaryKey="true" nullable="false"/>
        </column>
        <column name="county" type="VARCHAR(255)"/>
        <column name="parish" type="VARCHAR(255)"/>
        <column name="country" type="VARCHAR(255)"/>
        <column name="subcounty" type="VARCHAR(255)"/>
        <column name="village" type="VARCHAR(255)"/>
    </createTable>
</changeSet>


  <!-- 2. Create contact table -->
  <changeSet id="20250715-02-create-contact" author="elijah">
    <createTable tableName="contact">
      <column name="id" type="INT" autoIncrement="true">
        <constraints primaryKey="true" nullable="false"/>
      </column>
      <column name="contact_name" type="VARCHAR(255)"/>
    </createTable>
  </changeSet>

  <!-- 3. Create contact_number table -->
  <changeSet id="20250715-03-create-contact-number" author="elijah">
    <createTable tableName="contact_number">
      <column name="id" type="INT" autoIncrement="true">
        <constraints primaryKey="true" nullable="false"/>
      </column>
      <column name="uuid" type="VARCHAR(64)"/>
      <column name="contact_number" type="VARCHAR(255)"/>
      <column name="description" type="TEXT"/>
      <column name="contact_id" type="INT"/>
    </createTable>
    <addForeignKeyConstraint
      baseTableName="contact_number"
      baseColumnNames="contact_id"
      referencedTableName="contact"
      referencedColumnNames="id"
      constraintName="fk_contactnumber_contact"/>
  </changeSet>

  <!-- 4. Create emails table -->
  <changeSet id="20250715-04-create-emails" author="elijah">
    <createTable tableName="emails">
      <column name="id" type="INT" autoIncrement="true">
        <constraints primaryKey="true" nullable="false"/>
      </column>
      <column name="uuid" type="VARCHAR(64)"/>
      <column name="email" type="VARCHAR(255)"/>
      <column name="description" type="TEXT"/>
      <column name="contact_id" type="INT"/>
    </createTable>
    <addForeignKeyConstraint
      baseTableName="emails"
      baseColumnNames="contact_id"
      referencedTableName="contact"
      referencedColumnNames="id"
      constraintName="fk_emails_contact"/>
  </changeSet>

</databaseChangeLog>
